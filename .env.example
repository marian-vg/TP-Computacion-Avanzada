# .env.example - Plantilla de credenciales externas
# Copiar este archivo a '.env' y configurar con los valores correspondientes:
# cp .env.example .env

# API Key de Resend (obtenida en https://resend.com/api-keys)
RESEND_API_KEY=""

# Correo destinatario de las alertas
ALERT_EMAIL=""

# Remitente de Resend (en cuentas gratuitas de prueba usar 'onboarding@resend.dev')
ALERT_FROM="Alertas Debian <onboarding@resend.dev>"
